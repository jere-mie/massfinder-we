---
import '../styles/global.css';
import 'leaflet/dist/leaflet.css';
import { Navbar } from '../components/Navbar';
import { InstallBanner } from '../components/InstallBanner';
import {
	getBaseStructuredData,
	getCanonicalUrl,
	getSiteUrl,
	getSocialImageUrl,
	type StructuredData,
} from '../utils/seo';

interface Props {
	title?: string;
	description?: string;
	structuredData?: StructuredData | StructuredData[];
}

const { 
	title = 'Deanery of Windsor-Essex',
	description = 'Welcome to the Deanery of Windsor-Essex, a community of Catholic parishes serving the faithful in Windsor-Essex County, Ontario.',
	structuredData = [],
} = Astro.props;

const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = getCanonicalUrl(Astro.url.pathname, siteUrl);
const socialImageUrl = getSocialImageUrl(siteUrl);
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = [
	...getBaseStructuredData(description, siteUrl),
	...pageStructuredData,
];
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link rel="icon" type="image/png" href="/wedeanery-icon.png" />
		<link rel="manifest" href="/manifest.json" />
		<link rel="apple-touch-icon" href="/wedeanery-icon.png" />
		<link rel="canonical" href={canonicalUrl.href} />
		<meta name="theme-color" content="#2563eb" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="WE Deanery" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description}>

		<!-- Open Graph / Social Media Meta Tags -->
		<meta property="og:site_name" content="Deanery of Windsor-Essex" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl.href} />
		<meta property="og:image" content={socialImageUrl.href} />
		<meta property="og:image:alt" content="Deanery of Windsor-Essex" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="2458" />
		<meta property="og:image:height" content="761" />
		<meta property="og:locale" content="en_CA" />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl.href} />
		<meta name="twitter:image:alt" content="Deanery of Windsor-Essex" />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

		<script>
			(function () {
				// Capture `beforeinstallprompt` as early as possible and stash it on window
				// so the React banner can read it after hydration.
				window.__deferredInstallPrompt = null;
				window.addEventListener('beforeinstallprompt', function (e) {
					e.preventDefault();
					window.__deferredInstallPrompt = e;
					window.dispatchEvent(new CustomEvent('pwa-install-ready'));
				});

				window.addEventListener('appinstalled', function () {
					window.__deferredInstallPrompt = null;
					window.dispatchEvent(new CustomEvent('pwa-installed'));
				});
			})();
		</script>
	</head>
	<body class="bg-gray-50 min-h-screen">
		<InstallBanner client:load />
		<Navbar client:load />
		<main>
			<slot />
		</main>

		<script>
			(function () {
				// Register service worker (required for Chrome's install eligibility).
				if ('serviceWorker' in navigator) {
					window.addEventListener('load', function () {
						navigator.serviceWorker.register('/sw.js').catch(function (e) { console.warn('SW registration failed', e); });
					});
				}
			})();
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
